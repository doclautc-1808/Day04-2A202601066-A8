# Day 04 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; OpenRouter recommended) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)

# --- Research Scout web server ---
RESEARCH_SCOUT_PROVIDER=openrouter
# RESEARCH_SCOUT_MODEL=openai/gpt-4o-mini
RESEARCH_SCOUT_HISTORY_WINDOW=5
RESEARCH_SCOUT_MAX_TOOL_ROUNDS=4
RESEARCH_SCOUT_HOST=127.0.0.1
RESEARCH_SCOUT_PORT=8000

# --- Bonus delivery (optional, advanced track) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Local Ollama (no API key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
